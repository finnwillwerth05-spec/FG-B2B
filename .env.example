# =============================================================================
# Family Guardian B2B — environment variables
# Copy to .env.local for local dev. Never commit real values.
# Production values live in Vercel / Supabase project settings.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# After `pnpm db:start`, the local stack prints these values. Copy them here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Super-admin seed (local dev only; chained into `pnpm db:reset`) --------
# These credentials are written into auth.users by scripts/seed-super-admin.ts
# the first time `pnpm db:reset` runs against a fresh local DB. Never set
# these in staging or production.
SEED_SUPER_ADMIN_EMAIL=superadmin@fg-dev.local
SEED_SUPER_ADMIN_PASSWORD=fg-dev-superadmin-1234

# --- Email (Resend) ---------------------------------------------------------
# When RESEND_API_KEY is unset, @fg/email writes emails to .email-outbox/*.html
# and console-logs them — useful for local dev without a verified domain.
RESEND_API_KEY=
EMAIL_FROM=invites@fg-dev.local

# --- Anthropic (LLM analysis) ------------------------------------------------
ANTHROPIC_API_KEY=

# --- Voice provider ----------------------------------------------------------
# Which concrete provider to use behind @fg/voice. One of:
#   retell | vapi | elevenlabs_twilio | livekit
VOICE_PROVIDER=retell

# Retell (planned first concrete impl)
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_WEBHOOK_SECRET=

# VAPI (alternative)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ElevenLabs + Twilio (DIY orchestration)
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cron / internal endpoints ----------------------------------------------
# Random 32+ char string used to authenticate internal cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Observability (placeholder, not wired in foundation) -------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
