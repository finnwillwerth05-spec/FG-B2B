{
  "name": "fg-b2b",
  "version": "0.0.0",
  "private": true,
  "description": "Family Guardian AI — B2B platform for risk-bearing healthcare buyers",
  "packageManager": "pnpm@11.0.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm db:seed:super-admin",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > packages/database/src/generated.ts",
    "db:seed:super-admin": "tsx --env-file=.env.local scripts/seed-super-admin.ts",
    "db:setup": "pnpm db:start && pnpm db:reset && pnpm db:types",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "supabase": "^1.207.9",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2",
    "vitest": "^2.1.4",
    "@types/node": "^22.7.7",
    "tsx": "^4.19.2"
  }
}
